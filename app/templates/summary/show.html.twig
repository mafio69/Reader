
{% extends 'base.html.twig' %}

{% block title %}Streszczenie - {{ summary.originalUrl|slice(0, 50) }}...{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-md-10">
        <div class="card shadow-sm">
            <div class="card-header">
                <h5 class="card-title mb-0">Streszczenie artykułu</h5>
            </div>
            <div class="card-body">
                <h6 class="text-muted">Oryginalny URL:</h6>
                <p><a href="{{ summary.originalUrl }}" target="_blank">{{ summary.originalUrl }}</a></p>

                <hr>

                <h6 class="mt-4">Wygenerowane streszczenie:</h6>
                <div class="p-3 bg-light rounded">
                    <p style="white-space: pre-wrap;">{{ summary.summary }}</p>
                </div>

                <p class="text-muted mt-3 small">
                    Utworzono: {{ summary.createdAt|date('Y-m-d H:i:s') }}
                </p>
            </div>
            <div class="card-footer text-center">
                <a href="{{ path('app_summary_index') }}" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Powrót do listy
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
